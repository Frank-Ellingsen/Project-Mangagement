table raid_log

	column RiskID
		dataType: string
		sourceColumn: RiskID

	column Type
		dataType: string
		sourceColumn: Type

	column Description
		dataType: string
		sourceColumn: Description

	column Impact
		dataType: string
		sourceColumn: Impact

	column Probability
		dataType: string
		sourceColumn: Probability

	column MitigationStrategy
		dataType: string
		sourceColumn: MitigationStrategy

	column Owner
		dataType: string
		sourceColumn: Owner

	column Status
		dataType: string
		sourceColumn: Status

	partition raid_log-Partition = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("c:/Users/frank/Desktop/Project Mng/Data/CSV/raid_log.csv"),[Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalarTypes=true])
				in
				    Headers
