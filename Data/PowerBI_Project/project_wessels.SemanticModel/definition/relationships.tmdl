relationship rel_project_wbs
	fromColumn: wbs_elements.ProjectID
	toColumn: projects.ProjectID

relationship rel_wbs_timesheets
	fromColumn: timesheets.WBS_ID
	toColumn: wbs_elements.WBS_ID

relationship rel_resources_timesheets
	fromColumn: timesheets.ResourceID
	toColumn: resources.ResourceID

relationship rel_wbs_material_costs
	fromColumn: material_costs.WBS_ID
	toColumn: wbs_elements.WBS_ID

relationship rel_wbs_physical_progress
	fromColumn: physical_progress.WBS_ID
	toColumn: wbs_elements.WBS_ID
