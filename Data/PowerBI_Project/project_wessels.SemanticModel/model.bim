            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(\"C:\\Users\\frank\\Desktop\\Project Mng\\Data\\CSV\\physical_progress.csv\"),[Delimiter=\",\", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.None]),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalarTypes=true])\nin\n    Headers"
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "rel_project_wbs",
        "fromTable": "wbs_elements",
        "fromColumn": "ProjectID",
        "toTable": "projects",
        "toColumn": "ProjectID"
      },
      {
        "name": "rel_wbs_timesheets",
        "fromTable": "timesheets",
